# Supabase Configuration (if using Supabase for additional features)
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-key
VITE_SUPABASE_URL=https://your-project.supabase.co

# Neo4j Database Configuration
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_AUTH=your-base64-encoded-auth
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=your-instance-id
AURA_INSTANCENAME=your-instance-name

# Server Configuration
SERVER_URL=127.0.0.1:8000
VITE_SERVER_URL=http://127.0.0.1:8000

# LLM API Configuration (OpenRouter or OpenAI)
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=openrouter/free
LLM_API_KEY=your-llm-api-key

# Alternative OpenAI Configuration
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4
# LLM_API_KEY=your-openai-api-key

# Google OAuth Configuration
# Get these values from Google Cloud Console -> APIs & Services -> Credentials
# Create an OAuth 2.0 Client ID for a Web application
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Founder email for admin access
FOUNDER_EMAIL=your-email@example.com

# Background Processing Configuration
PROCESS_QUEUE_POLL_MS=5000

# ElevenLabs Configuration
# Get your API key from https://elevenlabs.io/app/speech-synthesis/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
